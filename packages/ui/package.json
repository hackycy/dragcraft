{
  "name": "@dragcraft/ui",
  "type": "module",
  "version": "0.0.4",
  "description": "Shared Vue UI modules for dragcraft",
  "author": "hackycy <hackycy@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/hackycy/dragcraft#readme",
  "repository": {
