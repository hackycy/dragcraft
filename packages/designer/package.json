{
  "name": "@dragcraft/designer",
  "type": "module",
  "version": "0.0.5",
  "description": "@dragcraft/designer",
  "author": "hackycy <hackycy@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/hackycy/dragcraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackycy/dragcraft.git"
  },
  "bugs": "https://github.com/hackycy/dragcraft/issues",
  "keywords": [],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./standard.css": "./dist/styles/standard.css",
    "./structure.css": "./dist/styles/structure.css",
    "./theme-contract.json": "./dist/theme-contract.json",
    "./css-custom-data.json": "./dist/css-custom-data.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm generate:theme-contract && pnpm check:theme && tsdown && pnpm check:package-exports && pnpm check:public-consumer",
    "check:package-exports": "node scripts/validate-package-exports.mjs",
    "check:public-consumer": "tsc -p fixtures/public-consumer/tsconfig.json",
    "check:theme": "node scripts/validate-theme-contract.mjs && node scripts/validate-theme-interactions.mjs",
    "dev": "tsdown --watch",
    "generate:theme-contract": "node scripts/generate-theme-custom-data.mjs",
    "lint": "eslint",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc && pnpm check:public-consumer"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "@dragcraft/core": "workspace:*",
    "@dragcraft/form-generator": "workspace:*",
    "@dragcraft/i18n": "workspace:*",
    "@dragcraft/icons": "workspace:*",
    "@dragcraft/renderer": "workspace:*",
    "@dragcraft/ui": "workspace:*",
    "@dragcraft/utils": "workspace:*",
    "@dragcraft/widgets": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "catalog:testing",
    "postcss": "catalog:cli",
    "postcss-selector-parser": "catalog:cli",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
